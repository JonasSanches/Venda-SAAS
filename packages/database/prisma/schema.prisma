generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  PENDING
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  DRAFT
  OPEN
  CONFIRMED
  PAID
  CANCELLED
}

enum ProductKind {
  STANDARD
  PIZZA
}

enum PizzaPricingRule {
  HIGHEST_PRICE
  AVERAGE
  PROPORTIONAL
}

enum PizzaModifierKind {
  ADDITION
  REMOVAL
}

enum PizzaProductionStatus {
  NEW
  PREPARING
  OVEN
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  LOSS
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
}

enum FiscalDocumentType {
  NFE
  NFCE
}

enum FiscalStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
  CONTINGENCY
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  SUPPLY
  WITHDRAWAL
  REVERSAL
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

// Recovery types beyond DETENTION are intentionally modeled now, while their
// operational screens can be added without changing the data model later.
enum TransportationLoadStatus {
  DRAFT
  ARRIVED
  DEPARTED
  CLOSED
}

enum TransportationRecoveryType {
  DETENTION
  LAYOVER
  TONU
  LUMPER
}

enum TransportationClaimStatus {
  DRAFT
  SUBMITTED
  PAID
  DENIED
}

model Tenant {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  document        String           @unique
  status          TenantStatus     @default(TRIAL)
  state           String?          @db.Char(2)
  city            String?
  segment         String?
  phone           String?
  logoDataUrl     String?          @map("logo_data_url")
  trialStartsAt   DateTime?        @map("trial_starts_at")
  trialExpiresAt  DateTime?        @map("trial_expires_at")
  subscriptionPlan String?        @map("subscription_plan")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  deliveryAlertMinutes Int        @default(45) @map("delivery_alert_minutes")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  branches        Branch[]
  users           User[]
  products        Product[]
  roles           Role[]
  cashSessions    CashSession[]
  cashMovements   CashMovement[]
  parties         Party[]
  fiscalSettings  FiscalSettings?
  billingPayments BillingPayment[]
  transportationLoads TransportationLoad[]
  transportationClaims TransportationRecoveryClaim[]
  modules         TenantModule[]
  pizzaSettings   PizzaSettings?
  pizzaSizes      PizzaSize[]
  pizzaFlavors    PizzaFlavor[]
  pizzaDoughs     PizzaDough[]
  pizzaCrusts     PizzaCrust[]
  pizzaModifiers  PizzaModifier[]
  pizzas          PizzaProduct[]
  pizzaProductSizes PizzaProductSize[]
  pizzaProductFlavors PizzaProductFlavor[]
  pizzaDoughSizes PizzaDoughSize[]
  pizzaCrustSizes PizzaCrustSize[]
  pizzaProductModifiers PizzaProductModifier[]
  pizzaOrders     PizzaOrder[]
  pizzaOrderItems PizzaOrderItem[]
  emailContacts EmailContact[]
  emailLists EmailList[]
  emailCampaigns EmailCampaign[]
  emailRecipients EmailCampaignRecipient[]
  emailTemplates EmailTemplate[]
  emailSettings EmailMarketingSettings?
  emailEvents EmailProviderEvent[]
  qrCheckoutLinks QrCheckoutLink[]
  qrCheckoutOrders QrCheckoutOrder[]

  @@map("tenants")
}

model TransportationLoad {
  id                      String                    @id @default(uuid()) @db.Uuid
  tenantId                String                    @map("tenant_id") @db.Uuid
  loadNumber              String                    @map("load_number")
  brokerName              String                    @map("broker_name")
  brokerEmail             String?                   @map("broker_email")
  brokerPhone             String?                   @map("broker_phone")
  origin                  String?
  destination             String?
  rateConfirmationNumber  String?                   @map("rate_confirmation_number")
  rateConfirmationTerms   String?                   @map("rate_confirmation_terms") @db.Text
  rateAmount              Decimal?                  @map("rate_amount") @db.Decimal(14, 2)
  detentionFreeMinutes    Int                       @default(120) @map("detention_free_minutes")
  detentionRatePerHour    Decimal                   @default(0) @map("detention_rate_per_hour") @db.Decimal(14, 2)
  detentionMinimumMinutes Int                       @default(0) @map("detention_minimum_minutes")
  vehicleCapacityTons     Decimal?                  @map("vehicle_capacity_tons") @db.Decimal(12, 3)
  recoveryMode            String                    @default("US_DETENTION") @map("recovery_mode") @db.VarChar(30)
  arrivalAt               DateTime?                 @map("arrival_at")
  departureAt             DateTime?                 @map("departure_at")
  status                  TransportationLoadStatus  @default(DRAFT)
  notes                   String?                   @db.Text
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  claims                  TransportationRecoveryClaim[]

  @@unique([tenantId, loadNumber])
  @@index([tenantId, status, createdAt])
  @@map("transportation_loads")
}

model TransportationRecoveryClaim {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  loadId            String                     @map("load_id") @db.Uuid
  claimNumber       String                     @map("claim_number")
  type              TransportationRecoveryType @default(DETENTION)
  status            TransportationClaimStatus  @default(DRAFT)
  elapsedMinutes    Int                        @default(0) @map("elapsed_minutes")
  billableMinutes   Int                        @default(0) @map("billable_minutes")
  ratePerHour       Decimal                    @default(0) @map("rate_per_hour") @db.Decimal(14, 2)
  calculatedAmount  Decimal                    @default(0) @map("calculated_amount") @db.Decimal(14, 2)
  requestedAmount   Decimal                    @default(0) @map("requested_amount") @db.Decimal(14, 2)
  currency          String                     @default("USD") @db.VarChar(3)
  termsSnapshot     Json?                      @map("terms_snapshot")
  denialReason      String?                    @map("denial_reason") @db.Text
  paymentReference  String?                    @map("payment_reference")
  submittedAt       DateTime?                  @map("submitted_at")
  paidAt            DateTime?                  @map("paid_at")
  deniedAt          DateTime?                  @map("denied_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  load              TransportationLoad         @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@unique([loadId, type])
  @@unique([tenantId, claimNumber])
  @@index([tenantId, status, createdAt])
  @@map("transportation_recovery_claims")
}

model BillingPayment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  externalReference String    @unique @map("external_reference")
  providerPaymentId String?   @map("provider_payment_id")
  preferenceId      String?   @map("preference_id")
  status            String    @default("PENDING")
  paymentMethod     String?   @map("payment_method")
  plan              String?
  amount            Decimal   @db.Decimal(14, 2)
  checkoutUrl       String?   @map("checkout_url")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("billing_payments")
}

model VisitorEvent {
  id             BigInt   @id @default(autoincrement())
  visitedAt      DateTime @default(now()) @map("visited_at")
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  path           String   @db.VarChar(300)
  referrer       String?  @db.VarChar(1000)
  userAgent      String?  @map("user_agent") @db.VarChar(1000)
  device         String?  @db.VarChar(30)
  browser        String?  @db.VarChar(30)
  operatingSystem String? @map("operating_system") @db.VarChar(30)
  language       String?  @db.VarChar(120)
  timezone       String?  @db.VarChar(120)
  platform       String?  @db.VarChar(160)
  screenWidth    Int?     @map("screen_width")
  screenHeight   Int?     @map("screen_height")
  viewportWidth  Int?     @map("viewport_width")
  viewportHeight Int?     @map("viewport_height")
  country        String?  @db.VarChar(80)
  region         String?  @db.VarChar(100)
  city           String?  @db.VarChar(120)

  @@index([visitedAt(sort: Desc)])
  @@index([ipAddress, visitedAt])
  @@map("visitor_events")
}

model VisitorExclusion {
  ipAddress String   @id @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("visitor_exclusions")
}

model SurveyResponse {
  id          String   @id @default(uuid()) @db.Uuid
  submittedAt DateTime @default(now()) @map("submitted_at")
  name        String   @db.VarChar(160)
  company     String   @db.VarChar(200)
  contact     String   @db.VarChar(200)
  language    String?  @db.VarChar(20)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  answers     Json

  @@index([submittedAt(sort: Desc)])
  @@map("survey_responses")
}

model Branch {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  name              String
  taxId             String           @map("tax_id")
  state             String           @db.Char(2)
  cityCode          String           @map("city_code")
  taxRegime         String           @map("tax_regime")
  stateRegistration String           @map("state_registration")
  createdAt         DateTime         @default(now()) @map("created_at")
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  warehouses        Warehouse[]
  orders            Order[]
  fiscalDocuments   FiscalDocument[]
  cashSessions      CashSession[]

  @@unique([tenantId, taxId])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(INVITED)
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  createdAt    DateTime   @default(now()) @map("created_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roles        UserRole[]

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String
  permissions String[]
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  sku            String
  barcode        String?
  designTemplate String?         @map("design_template")
  designData     Json?           @map("design_data")
  name           String
  imageDataUrl   String?         @map("image_data_url") @db.Text
  price          Decimal         @db.Decimal(14, 2)
  cost           Decimal         @default(0) @db.Decimal(14, 4)
  ncm            String?
  cest           String?
  cfop           String?
  csosn          String?
  pisCst         String?         @map("pis_cst")
  cofinsCst      String?         @map("cofins_cst")
  active         Boolean         @default(true)
  kind           ProductKind     @default(STANDARD)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  pizza          PizzaProduct?
  qrCheckoutOffers QrCheckoutOffer[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

// Feature flags are deliberately tenant-scoped. Existing businesses keep their
// current experience until an administrator enables a module for that tenant.
model TenantModule {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  module      String   @db.VarChar(80)
  enabled     Boolean  @default(false)
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId, enabled])
  @@map("tenant_modules")
}

enum EmailContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  BLOCKED
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PAUSED
  SENT
  CANCELED
  FAILED
}

enum EmailRecipientStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

model EmailContact {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  firstName   String?            @map("first_name") @db.VarChar(120)
  lastName    String?            @map("last_name") @db.VarChar(120)
  email       String             @db.VarChar(320)
  phone       String?            @db.VarChar(40)
  company     String?            @db.VarChar(160)
  tags        String[]           @default([])
  source      String?            @db.VarChar(120)
  notes       String?            @db.Text
  status      EmailContactStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  tenant      Tenant             @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  lists       EmailListMember[]
  recipients  EmailCampaignRecipient[]

  @@unique([tenantId,email])
  @@index([tenantId,status,createdAt])
  @@index([tenantId,company])
  @@map("email_contacts")
}

model EmailList {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String            @db.VarChar(160)
  description String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  tenant      Tenant            @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  members     EmailListMember[]
  campaigns   EmailCampaign[]

  @@unique([tenantId,name])
  @@index([tenantId,createdAt])
  @@map("email_lists")
}

model EmailListMember {
  emailListId    String       @map("email_list_id") @db.Uuid
  emailContactId String       @map("email_contact_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  list           EmailList    @relation(fields:[emailListId],references:[id],onDelete:Cascade)
  contact        EmailContact @relation(fields:[emailContactId],references:[id],onDelete:Cascade)

  @@id([emailListId,emailContactId])
  @@index([emailContactId])
  @@map("email_list_members")
}

model EmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(160)
  subject     String?  @db.VarChar(250)
  html        String   @db.Text
  text        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields:[tenantId],references:[id],onDelete:Cascade)

  @@unique([tenantId,name])
  @@index([tenantId,updatedAt])
  @@map("email_templates")
}

model EmailCampaign {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  listId        String?             @map("list_id") @db.Uuid
  name          String              @db.VarChar(180)
  subject       String              @db.VarChar(250)
  fromName      String              @map("from_name") @db.VarChar(160)
  fromEmail     String              @map("from_email") @db.VarChar(320)
  replyTo       String?             @map("reply_to") @db.VarChar(320)
  html          String              @db.Text
  text          String?             @db.Text
  segment       Json?
  scheduledAt   DateTime?           @map("scheduled_at")
  status        EmailCampaignStatus @default(DRAFT)
  startedAt     DateTime?           @map("started_at")
  completedAt   DateTime?           @map("completed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  tenant        Tenant              @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  list          EmailList?          @relation(fields:[listId],references:[id],onDelete:SetNull)
  recipients    EmailCampaignRecipient[]

  @@index([tenantId,status,scheduledAt])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  campaignId        String               @map("campaign_id") @db.Uuid
  contactId         String               @map("contact_id") @db.Uuid
  email             String               @db.VarChar(320)
  providerMessageId String?              @map("provider_message_id") @db.VarChar(250)
  status            EmailRecipientStatus @default(QUEUED)
  attempts          Int                  @default(0)
  availableAt       DateTime             @default(now()) @map("available_at")
  sentAt            DateTime?            @map("sent_at")
  deliveredAt       DateTime?            @map("delivered_at")
  openedAt          DateTime?            @map("opened_at")
  clickedAt         DateTime?            @map("clicked_at")
  bouncedAt         DateTime?            @map("bounced_at")
  failedAt          DateTime?            @map("failed_at")
  unsubscribedAt    DateTime?            @map("unsubscribed_at")
  errorMessage      String?              @map("error_message") @db.Text
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  tenant            Tenant               @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  campaign          EmailCampaign        @relation(fields:[campaignId],references:[id],onDelete:Cascade)
  contact           EmailContact         @relation(fields:[contactId],references:[id],onDelete:Cascade)

  @@unique([campaignId,contactId])
  @@index([tenantId,status,availableAt])
  @@index([providerMessageId])
  @@map("email_campaign_recipients")
}

model EmailProviderEvent {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  recipientId     String?  @map("recipient_id") @db.Uuid
  providerEventId String?  @map("provider_event_id") @db.VarChar(250)
  providerMessageId String? @map("provider_message_id") @db.VarChar(250)
  eventType       String   @map("event_type") @db.VarChar(80)
  payload         Json?
  createdAt       DateTime @default(now()) @map("created_at")
  tenant          Tenant   @relation(fields:[tenantId],references:[id],onDelete:Cascade)

  @@unique([tenantId,providerEventId])
  @@index([tenantId,createdAt])
  @@map("email_provider_events")
}

model EmailMarketingSettings {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  fromName       String?  @map("from_name") @db.VarChar(160)
  fromEmail      String?  @map("from_email") @db.VarChar(320)
  replyTo        String?  @map("reply_to") @db.VarChar(320)
  ratePerMinute  Int      @default(60) @map("rate_per_minute")
  timezone       String   @default("America/Sao_Paulo") @db.VarChar(80)
  updatedAt      DateTime @updatedAt @map("updated_at")
  tenant         Tenant   @relation(fields:[tenantId],references:[id],onDelete:Cascade)

  @@map("email_marketing_settings")
}

enum QrCheckoutOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model QrCheckoutLink {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(160)
  token           String   @unique @db.VarChar(80)
  deliveryEnabled Boolean  @default(false) @map("delivery_enabled")
  addressRequired Boolean  @default(false) @map("address_required")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tenant          Tenant   @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  offers          QrCheckoutOffer[]
  orders          QrCheckoutOrder[]
  @@index([tenantId,active])
  @@map("qr_checkout_links")
}
model QrCheckoutOffer {
  id          String         @id @default(uuid()) @db.Uuid
  linkId      String         @map("link_id") @db.Uuid
  productId   String?        @map("product_id") @db.Uuid
  title       String         @db.VarChar(180)
  description String?        @db.Text
  price       Decimal        @db.Decimal(14,2)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at")
  link        QrCheckoutLink @relation(fields:[linkId],references:[id],onDelete:Cascade)
  product     Product?       @relation(fields:[productId],references:[id],onDelete:SetNull)
  items       QrCheckoutOrderItem[]
  @@index([linkId,active])
  @@map("qr_checkout_offers")
}
model QrCheckoutOrder {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  linkId            String                @map("link_id") @db.Uuid
  externalReference String                @unique @map("external_reference")
  providerPaymentId String?               @map("provider_payment_id")
  buyerName         String                @map("buyer_name") @db.VarChar(160)
  buyerEmail        String?               @map("buyer_email") @db.VarChar(320)
  buyerPhone        String?               @map("buyer_phone") @db.VarChar(40)
  deliveryAddress   String?               @map("delivery_address") @db.Text
  total             Decimal               @db.Decimal(14,2)
  platformCommissionRate Decimal          @default(0.12) @map("platform_commission_rate") @db.Decimal(5,4)
  platformCommissionAmount Decimal        @default(0) @map("platform_commission_amount") @db.Decimal(14,2)
  merchantAmount    Decimal               @default(0) @map("merchant_amount") @db.Decimal(14,2)
  status            QrCheckoutOrderStatus @default(PENDING)
  createdAt         DateTime              @default(now()) @map("created_at")
  paidAt            DateTime?             @map("paid_at")
  tenant            Tenant                @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  link              QrCheckoutLink        @relation(fields:[linkId],references:[id],onDelete:Restrict)
  items             QrCheckoutOrderItem[]
  @@index([tenantId,status,createdAt])
  @@map("qr_checkout_orders")
}
model QrCheckoutOrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  offerId   String          @map("offer_id") @db.Uuid
  productId String?         @map("product_id") @db.Uuid
  title     String          @db.VarChar(180)
  quantity  Int             @default(1)
  unitPrice Decimal         @map("unit_price") @db.Decimal(14,2)
  total     Decimal         @db.Decimal(14,2)
  order     QrCheckoutOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
  offer     QrCheckoutOffer @relation(fields:[offerId],references:[id])
  @@index([orderId])
  @@map("qr_checkout_order_items")
}

model PizzaSettings {
  tenantId     String           @id @map("tenant_id") @db.Uuid
  pricingRule  PizzaPricingRule @default(HIGHEST_PRICE) @map("pricing_rule")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pizza_settings")
}

model PizzaSize {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(80)
  maxFlavors  Int      @default(1) @map("max_flavors")
  serves      Int?
  active      Boolean  @default(true)
