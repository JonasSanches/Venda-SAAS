  nfeSeries         Int    @map("nfe_series")
  nfceSeries        Int    @map("nfce_series")
  environment       String @default("HOMOLOGATION")
  tenant            Tenant @relation(fields: [tenantId], references: [id])

  @@map("fiscal_settings")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  unitCost  Decimal? @map("unit_cost") @db.Decimal(14, 4)
  total     Decimal @db.Decimal(14, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([tenantId, orderId])
  @@map("order_items")
}

model Payment {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  method     String
  amount     Decimal @db.Decimal(14, 2)
  status     String
  externalId String? @map("external_id")
  order      Order   @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@map("payments")
}

model FiscalDocument {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  branchId        String             @map("branch_id") @db.Uuid
  orderId         String             @map("order_id") @db.Uuid
  type            FiscalDocumentType
  status          FiscalStatus       @default(PENDING)
  series          Int
  number          BigInt
  accessKey       String?            @map("access_key")
  protocol        String?
  rejectionCode   String?            @map("rejection_code")
  rejectionReason String?            @map("rejection_reason")
  xmlObjectKey    String?            @map("xml_object_key")
  idempotencyKey  String             @map("idempotency_key")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  branch          Branch             @relation(fields: [branchId], references: [id])
  order           Order              @relation(fields: [orderId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, branchId, type, series, number])
  @@index([tenantId, status, createdAt])
  @@map("fiscal_documents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  requestId  String   @map("request_id")
  ip         String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  topic       String
  aggregateId String    @map("aggregate_id")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)

  @@index([processedAt, createdAt])
  @@index([tenantId])
  @@map("outbox_events")
}

model DigitalPurchase {
  id                String    @id @default(uuid()) @db.Uuid
  externalReference String    @unique @map("external_reference")
  downloadToken     String    @unique @map("download_token")
  productSlug       String    @map("product_slug")
  format            String
  email             String
  amount            Decimal   @db.Decimal(10, 2)
  status            String    @default("PENDING")
  providerPaymentId String?   @map("provider_payment_id")
  preferenceId      String?   @map("preference_id")
  checkoutUrl       String?   @map("checkout_url")
  paidAt            DateTime? @map("paid_at")
  downloadCount     Int       @default(0) @map("download_count")
  lastDownloadedAt  DateTime? @map("last_downloaded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([email, createdAt])
  @@index([status])
  @@map("digital_purchases")
}

// This account is deliberately separate from Tenant/User. A library member is
// a buyer of digital books, not a user of a Venda+ business account.
model LibraryMembership {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  status            String    @default("PENDING")
  amount            Decimal   @default(59.90) @db.Decimal(10, 2)
  externalReference String    @unique @map("external_reference")
  checkoutToken     String    @unique @map("checkout_token")
  providerPaymentId String?   @map("provider_payment_id")
  preferenceId      String?   @map("preference_id")
  checkoutUrl       String?   @map("checkout_url")
  paymentMethod     String?   @map("payment_method")
  paidAt            DateTime? @map("paid_at")
  sessionVersion    Int       @default(0) @map("session_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([email, createdAt])
  @@map("library_memberships")
}

model CuratedBook {
  id          String   @id @default(uuid()) @db.Uuid
  source      String
  externalId  String   @unique @map("external_id")
  title       String
  author      String?
  year        String?
  license     String
  sourceUrl   String   @map("source_url")
  coverUrl    String   @map("cover_url")
  pdfUrl      String   @map("pdf_url")
  score       Int      @default(0)
  discoveredAt DateTime @default(now()) @map("discovered_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([score, discoveredAt])
  @@map("curated_books")
}
