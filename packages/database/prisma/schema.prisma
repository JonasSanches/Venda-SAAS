  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("pizza_sizes")
}

model PizzaFlavor {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(120)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pizzas      PizzaProductFlavor[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("pizza_flavors")
}

model PizzaDough {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(80)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sizes       PizzaDoughSize[]

  @@unique([tenantId, name])
  @@map("pizza_doughs")
}

model PizzaCrust {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(80)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sizes       PizzaCrustSize[]

  @@unique([tenantId, name])
  @@map("pizza_crusts")
}

model PizzaModifier {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String            @db.VarChar(120)
  kind        PizzaModifierKind
  price       Decimal           @default(0) @db.Decimal(14, 2)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pizzas      PizzaProductModifier[]

  @@unique([tenantId, name, kind])
  @@index([tenantId, kind, active])
  @@map("pizza_modifiers")
}

model PizzaProduct {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @unique @map("product_id") @db.Uuid
  active      Boolean  @default(true)
  availableFrom String? @map("available_from") @db.VarChar(5)
  availableTo   String? @map("available_to") @db.VarChar(5)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizes       PizzaProductSize[]
  flavors     PizzaProductFlavor[]
  modifiers   PizzaProductModifier[]
  orderItems  PizzaOrderItem[]

  @@unique([tenantId, productId])
  @@index([tenantId, active])
  @@map("pizza_products")
}

// Pizza orders are intentionally separate from the fiscal checkout. They retain
// the exact choices sent to production, while a payment/fiscal flow can consume
// the final ticket when the operation is ready to close it.
model PizzaOrder {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  number       Int
  status       PizzaProductionStatus @default(NEW)
  serviceType  String                @default("COUNTER") @map("service_type") @db.VarChar(30)
  paymentState String                @default("PENDING") @map("payment_state") @db.VarChar(20)
  customerId   String?               @map("customer_id") @db.Uuid
  customerName String?               @map("customer_name") @db.VarChar(160)
  customerPhone String?              @map("customer_phone") @db.VarChar(40)
  address      String?               @db.Text
  notes        String?               @db.Text
  total        Decimal               @default(0) @db.Decimal(14, 2)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Party?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        PizzaOrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@map("pizza_orders")
}

model PizzaOrderItem {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  pizzaOrderId String       @map("pizza_order_id") @db.Uuid
  pizzaProductId String     @map("pizza_product_id") @db.Uuid
  quantity     Int          @default(1)
  unitPrice    Decimal      @map("unit_price") @db.Decimal(14, 2)
  total        Decimal      @db.Decimal(14, 2)
  selection    Json
  order        PizzaOrder   @relation(fields: [pizzaOrderId], references: [id], onDelete: Cascade)
  pizza        PizzaProduct @relation(fields: [pizzaProductId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, pizzaOrderId])
  @@map("pizza_order_items")
}

model PizzaProductSize {
  tenantId       String @map("tenant_id") @db.Uuid
  pizzaProductId String @map("pizza_product_id") @db.Uuid
  sizeId         String @map("size_id") @db.Uuid
  price          Decimal @db.Decimal(14, 2)
  pizza          PizzaProduct @relation(fields: [pizzaProductId], references: [id], onDelete: Cascade)
  size           PizzaSize    @relation(fields: [sizeId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([pizzaProductId, sizeId])
  @@index([tenantId])
  @@map("pizza_product_sizes")
}

model PizzaProductFlavor {
  tenantId       String @map("tenant_id") @db.Uuid
  pizzaProductId String @map("pizza_product_id") @db.Uuid
  flavorId       String @map("flavor_id") @db.Uuid
  price          Decimal @db.Decimal(14, 2)
  pizza          PizzaProduct @relation(fields: [pizzaProductId], references: [id], onDelete: Cascade)
  flavor         PizzaFlavor  @relation(fields: [flavorId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([pizzaProductId, flavorId])
  @@index([tenantId])
  @@map("pizza_product_flavors")
}

model PizzaDoughSize {
  tenantId      String @map("tenant_id") @db.Uuid
  doughId       String @map("dough_id") @db.Uuid
  sizeId        String @map("size_id") @db.Uuid
  price         Decimal @default(0) @db.Decimal(14, 2)
  dough         PizzaDough @relation(fields: [doughId], references: [id], onDelete: Cascade)
  size          PizzaSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([doughId, sizeId])
  @@index([tenantId])
  @@map("pizza_dough_sizes")
}

model PizzaCrustSize {
  tenantId      String @map("tenant_id") @db.Uuid
  crustId       String @map("crust_id") @db.Uuid
  sizeId        String @map("size_id") @db.Uuid
  price         Decimal @default(0) @db.Decimal(14, 2)
  crust         PizzaCrust @relation(fields: [crustId], references: [id], onDelete: Cascade)
  size          PizzaSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([crustId, sizeId])
  @@index([tenantId])
  @@map("pizza_crust_sizes")
}

model PizzaProductModifier {
  tenantId       String @map("tenant_id") @db.Uuid
  pizzaProductId String @map("pizza_product_id") @db.Uuid
  modifierId     String @map("modifier_id") @db.Uuid
  pizza          PizzaProduct  @relation(fields: [pizzaProductId], references: [id], onDelete: Cascade)
  modifier       PizzaModifier @relation(fields: [modifierId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([pizzaProductId, modifierId])
  @@index([tenantId])
  @@map("pizza_product_modifiers")
}

model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  branchId  String          @map("branch_id") @db.Uuid
  name      String
  branch    Branch          @relation(fields: [branchId], references: [id])
  movements StockMovement[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
  @@map("warehouses")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  type        StockMovementType
  quantity    Decimal           @db.Decimal(14, 3)
  unitCost    Decimal           @map("unit_cost") @db.Decimal(14, 4)
  referenceId String?           @map("reference_id") @db.Uuid
  occurredAt  DateTime          @default(now()) @map("occurred_at")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])

  @@index([tenantId, warehouseId, productId, occurredAt])
  @@map("stock_movements")
}

model Order {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  branchId        String           @map("branch_id") @db.Uuid
  cashSessionId   String?          @map("cash_session_id") @db.Uuid
  number          BigInt
  status          OrderStatus      @default(DRAFT)
  channel         String
  subtotal        Decimal          @db.Decimal(14, 2)
  discount        Decimal          @default(0) @db.Decimal(14, 2)
  total           Decimal          @db.Decimal(14, 2)
  createdAt       DateTime         @default(now()) @map("created_at")
  deliveredAt     DateTime?        @map("delivered_at")
  cancelledAt     DateTime?        @map("cancelled_at")
  cancelReason    String?          @map("cancel_reason")
  branch          Branch           @relation(fields: [branchId], references: [id])
  cashSession     CashSession?     @relation(fields: [cashSessionId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  fiscalDocuments FiscalDocument[]

  @@unique([tenantId, branchId, number])
  @@index([tenantId, createdAt])
  @@index([tenantId, branchId, channel, createdAt])
  @@map("orders")
}

model CashSession {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @map("opening_amount") @db.Decimal(14, 2)
  declaredAmount Decimal?          @map("declared_amount") @db.Decimal(14, 2)
  difference     Decimal?          @db.Decimal(14, 2)
  openedAt       DateTime          @default(now()) @map("opened_at")
  closedAt       DateTime?         @map("closed_at")
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])
  movements      CashMovement[]
  orders         Order[]

  @@index([tenantId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  cashSessionId String           @map("cash_session_id") @db.Uuid
  type          CashMovementType
  amount        Decimal          @db.Decimal(14, 2)
  paymentMethod String           @map("payment_method")
  note          String
  orderId       String?          @map("order_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id])

  @@index([tenantId, cashSessionId, createdAt])
  @@map("cash_movements")
}

model Party {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  type      PartyType
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?   @db.Text
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  pizzaOrders PizzaOrder[]

  @@unique([tenantId, document])
  @@index([tenantId, type])
  @@map("parties")
}

model FiscalSettings {
  tenantId          String @id @map("tenant_id") @db.Uuid
  state             String @db.Char(2)
  taxRegime         String @map("tax_regime")
  stateRegistration String @map("state_registration")
