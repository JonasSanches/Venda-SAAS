DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="generate-a-random-secret-with-at-least-64-characters"
JWT_ISSUER="vendamais-app"
WEB_ORIGIN="https://www.vendamais-app.com"
DEMO_MODE=false
SEFAZ_ENVIRONMENT=homologation
FISCAL_ENABLED_UFS=SP,RJ
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="replace-with-a-strong-password"
PLATFORM_ADMIN_NAME="Administrador da Plataforma"
PUBLIC_APP_URL="https://www.vendamais-app.com"
PLATFORM_MONTHLY_PRICE="49.90"
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-substitua-pela-credencial-de-producao"
MERCADO_PAGO_SANDBOX="false"
STRIPE_SECRET_KEY="sk_live_replace_with_your_stripe_secret_key"
# E-mail Marketing (Resend). Keep real credentials only in .env.production on the VPS.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_replace_with_your_resend_key"
EMAIL_FROM_ADDRESS="contato@seu-dominio.com"
EMAIL_FROM_NAME="Sua empresa"
EMAIL_WEBHOOK_SECRET="generate-a-random-webhook-secret"
EMAIL_UNSUBSCRIBE_SECRET="generate-a-random-unsubscribe-secret"
EMAIL_SEND_RATE_PER_MINUTE="60"
